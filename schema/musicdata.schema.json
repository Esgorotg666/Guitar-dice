{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://guitar-dice.vercel.app/schema/musicdata.schema.json",
  "title": "Guitar Dice music data",
  "type": "object",
  "required": ["chords", "modes"],
  "additionalProperties": false,
  "properties": {
    "chords": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["name", "positions"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "positions": {
            "type": "array",
            "minItems": 6,
            "maxItems": 7,
            "items": {
              "anyOf": [
                { "type": "integer", "minimum": 0, "maximum": 24 },
                { "const": "X" }
              ]
            }
          },
          "fret": { "type": "integer", "minimum": 0, "maximum": 24 }
        }
      }
    },
    "modes": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": ["id", "name", "quality", "intervals", "degrees", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "quality": { "enum": ["major", "minor", "diminished"] },
          "intervals": {
            "type": "array",
            "minItems": 7,
            "maxItems": 7,
            "items": { "type": "integer", "minimum": 0, "maximum": 11 }
          },
          "degrees": {
            "type": "array",
            "minItems": 7,
            "maxItems": 7,
            "items": { "type": "string", "minLength": 1 }
          },
          "description": { "type": "string" }
        }
      }
    }
  }
}
